# If your network is IPv4-only, use the Session Pooler host and username
# shown in Supabase Dashboard > Connect instead of the direct host below.
HOST=db.<project-ref>.supabase.co
PORT=5432
DATABASE=postgres
USER=postgres
PASSWORD=your_supabase_database_password

STT_API_KEY=your_sarvam_api_key
# Generate a private random secret to enable POST /admin/clean-data.
CLEAN_DATA_API_KEY=
